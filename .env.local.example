# Supabase — copy dari Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Hanya dipakai di server (Edge Functions / API Routes) — jangan expose ke client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin email tujuan notifikasi
ADMIN_EMAIL=cotch.data@gmail.com

# URL server-side untuk link di email
SITE_URL=http://localhost:3000

# Optional public site URL jika nanti dipakai di client
NEXT_PUBLIC_SITE_URL=https://thisiscotch.vercel.app

# SMTP parity dari versi PHP lama
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=your-smtp-user@example.com
MAIL_SMTP_PASS=your-smtp-password
MAIL_FROM=cotch.data@gmail.com
MAIL_FROM_NAME=Cotch Reservation
